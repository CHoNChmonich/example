# PostgreSQL приложения: контейнер db читает POSTGRES_USER/PASSWORD/DB, приложение — все POSTGRES_*
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
# Хост и порт для запуска с хоста (dev-стенд публикует db на этом порту); внутри compose
# контейнеры ходят на db:5432. Если 5432 занят — задайте другой, например 5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ECHO_SQL=false

# PostgreSQL интеграционных тестов — отдельный контейнер db_for_tests (правила те же);
# если TEST_POSTGRES_* не заданы, интеграционные тесты БД пропускаются
TEST_POSTGRES_USER=orders
TEST_POSTGRES_PASSWORD=orders
TEST_POSTGRES_DB=orders_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433

# API (deployment/entrypoints/entrypoint_api.sh)
# Порт API на хосте: dev-стенд публикует api напрямую, в production — только через nginx
APP_PORT=8000
API_WORKER_COUNT=4
# Дополнительные аргументы uvicorn
ADDITIONAL_API_ARGS=

# Настройки приложения (launchers/config.py)
LOG_LEVEL=INFO
# Объёмная скидка: процент от суммы заказа при общем количестве единиц >= порога
DISCOUNT_MIN_QUANTITY=10
DISCOUNT_PERCENT=5

# pgAdmin (dev: http://localhost:5050/, через nginx: /pgadmin4/)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# nginx — порт на хосте
NGINX_EXTERNAL_PORT=8080
