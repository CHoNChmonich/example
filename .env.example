# PostgreSQL приложения: контейнер db читает POSTGRES_USER/PASSWORD/DB, приложение — все POSTGRES_*
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
# Хост и порт для запуска с хоста (dev-стенд публикует db на этом порту); внутри compose
# контейнеры ходят на db:5432. Если 5432 занят — задайте другой, например 5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ECHO_SQL=false

# PostgreSQL интеграционных тестов — отдельный контейнер db_for_tests dev-стенда (правила те же);
# если TEST_POSTGRES_* не заданы, интеграционные тесты БД пропускаются
TEST_POSTGRES_USER=orders
TEST_POSTGRES_PASSWORD=orders
TEST_POSTGRES_DB=orders_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433

# API (deployment/entrypoints/entrypoint_api.sh)
# Порт API на хосте: dev-стенд публикует api напрямую, в production — только через nginx
APP_PORT=8000
API_WORKER_COUNT=4
# Дополнительные аргументы uvicorn
ADDITIONAL_API_ARGS=

# Логирование (adapters/log/settings.py): уровень корневого логгера и формат записей;
# text — для человека, json — для сборщиков логов (в production)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Трассировка (adapters/tracing/settings.py): none — спаны строятся и отбрасываются,
# идентификаторы в логах есть; console — спаны в stdout; otlp — OTLP/HTTP на endpoint
TRACING_EXPORTER=console
TRACING_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SERVICE_NAME=orders-service
# Доля записываемых корневых трасс 0..1 (решение родителя из traceparent уважается);
# ресурс спанов: версия (по умолчанию — версия пакета), окружение, идентификатор экземпляра
# (по умолчанию — hostname: в контейнере это его id или имя пода)
TRACING_SAMPLE_RATIO=1.0
TRACING_ENVIRONMENT=development
# TRACING_SERVICE_VERSION=0.1.0
# TRACING_SERVICE_INSTANCE_ID=orders-1

# Настройки приложения (launchers/config.py)
# Объёмная скидка: процент от суммы заказа при общем количестве единиц >= порога
DISCOUNT_MIN_QUANTITY=10
DISCOUNT_PERCENT=5

# pgAdmin (dev: http://localhost:5050/, через nginx: /pgadmin4/)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# nginx — порт на хосте
NGINX_EXTERNAL_PORT=8080
